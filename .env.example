# Ushbu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env
# .env faylini HECH QACHON GitHub'ga yuklamang (.gitignore buni oldini oladi).

# @BotFather bergan token
BOT_TOKEN=

# Google jadval ID si yoki to'liq havolasi
# (havoladagi /d/ va /edit orasidagi qism)
SPREADSHEET_ID=

# Adminlar Telegram ID lari, vergul bilan (ID ni @userinfobot dan bilib olasiz)
# Adminlar yangi xodimlarni tasdiqlaydi.
ADMIN_IDS=

# Google service account kalit fayli (loyiha papkasiga nisbatan yoki to'liq yo'l)
GOOGLE_CREDENTIALS=credentials.json

# Hisobotlar va rasmlar joylanadigan yopiq kanal (ixtiyoriy, lekin tavsiya etiladi).
# Format: -1001234567890. Bot kanalda admin bo'lishi kerak.
# ID ni bilish: bot ishga tushgach, kanal postini botga forward qiling (admin sifatida).
CHANNEL_ID=

# Vaqt zonasi (jadvalga yoziladigan sana va vaqt uchun)
TIMEZONE=Asia/Tashkent
